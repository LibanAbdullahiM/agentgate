# Copy to .env (never commit .env). Both secrets must be at least 32 characters.
JWT_SECRET=change-me-change-me-change-me-change-me-0001
QUOTE_SIGNING_SECRET=change-me-change-me-change-me-change-me-0002
DB_PASSWORD=agentgate
DB_PORT=5432

# mock = built-in fake prices/stock (works offline). live = call Valio's mock API.
VALIO_MODE=mock
# Get the key from the Junction platform / challenge page. Do NOT commit it.
VALIO_API_KEY=

# Frontend origins allowed by CORS (React dev servers)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Demo users: buyer-admin, approver, agent-1 (all share SEED_PASSWORD)
SEED_ENABLED=true
SEED_PASSWORD=demo1234
